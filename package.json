{
	"name": "whatsapp-prospecao",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Automacao local de conversas no WhatsApp para prospeccao B2B (Fase 01: fundacao, canal e gate de envio).",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"start": "npm run dev",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
		"build": "npm run typecheck && vite build",
		"web:dev": "vite",
		"web:build": "vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:verify": "node scripts/lint-verify-chains.mjs .planning/phases/01-funda-o-canal-e-gate-de-envio",
		"db:generate": "drizzle-kit generate",
		"backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
		"notify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/notify.ps1",
		"shadow:list": "tsx src/cli/shadow.ts list",
		"shadow:approve": "tsx src/cli/shadow.ts approve",
		"shadow:edit": "tsx src/cli/shadow.ts edit",
		"shadow:discard": "tsx src/cli/shadow.ts discard",
		"mode": "tsx src/cli/mode.ts",
		"status:corrigir": "tsx src/cli/status.ts corrigir",
		"handoff:ack": "tsx src/cli/handoff.ts ack",
		"shadow:report": "tsx scripts/shadow-report.ts",
		"bake-off": "tsx scripts/bake-off.ts",
		"pilot:calibrate": "tsx src/cli/calibrate.ts",
		"pilot:report": "tsx src/cli/report-pilot.ts",
		"test:llm": "tsx src/cli/test-llm.ts",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.79",
		"@ai-sdk/google": "4.0.94",
		"@ai-sdk/openai": "4.0.92",
		"@fastify/static": "10.1.6",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@types/node": "24.19.0",
		"@types/qrcode-terminal": "^0.12.2",
		"@whiskeysockets/baileys": "7.0.0-rc14",
		"ai": "7.0.138",
		"croner": "10.0.1",
		"drizzle-orm": "0.45.3",
		"fastify": "5.12.7",
		"p-queue": "9.3.3",
		"papaparse": "^5.7.1",
		"pg": "8.23.0",
		"pino": "10.3.1",
		"qrcode-terminal": "^0.12.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@fast-check/vitest": "0.5.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/papaparse": "^5.5.2",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"drizzle-kit": "0.31.11",
		"fast-check": "4.10.2",
		"lucide-react": "1.57.0",
		"patch-package": "8.0.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.2"
	}
}
