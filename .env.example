# COMP-05 / D-01 — Pasta fora da arvore do OneDrive e do git (obrigatorio no Windows).
# O sistema aborta o boot imediatamente se detectar ReparsePoint (OneDrive sync).
DATA_ROOT=C:\whatsapp_prospecao

# R-031 — URL de conexao com o PostgreSQL 18.x local.
# O banco deve estar rodando localmente (127.0.0.1:5432).
DATABASE_URL=postgres://seu_usuario:sua_senha@127.0.0.1:5432/whatsapp_prospect

# WHS-05 — Numero dedicado exclusivo para a prospeccao em formato internacional E.164.
CHANNEL_PHONE_E164=+5511999999999

# D-18 / T-03-12 — Token Bearer secreto para autenticar o painel web local (http://127.0.0.1:8787).
# Obrigatorio: qualquer string aleatoria e segura.
PANEL_TOKEN=segredo_super_forte_para_o_painel_local

# Porta do servidor Fastify / painel web (padrao: 8787).
PANEL_PORT=8787

# Provedor de LLM: "openai" | "anthropic" | "google" (padrao: openai).
LLM_PROVIDER=openai

# Modelo da IA (padrao: gpt-4o-mini).
LLM_MODEL=gpt-4o-mini

# Chave de API do provedor de LLM configurado acima.
LLM_API_KEY=sua_chave_de_api_aqui

# R-023 — Trava de novos contatos abordados por dia util (padrao: 20).
DAILY_LEAD_LIMIT=20

# R-023 — Trava maxima operacional de mensagens enviadas por dia util (teto fisico: 30, padrao: 25).
DAILY_MESSAGE_LIMIT=25

# R-006 / AR-007 — Janela operacional comercial (padrao: 7h as 17h em dias uteis).
WINDOW_START_HOUR=7
WINDOW_END_HOUR=17

# Fuso horario de referencia das regras de negocio e feriados BR (padrao: America/Sao_Paulo).
TZ=America/Sao_Paulo

# R-042 — Kill switch de emergencia. Se true, bloqueia imediatamente qualquer envio.
KILL_SWITCH=false

# Nivel de log do socket WhatsApp/Baileys ("warn" | "info" | "debug" | "trace").
BAILEYS_LOG_LEVEL=warn

# Modo de identificacao do navegador no Baileys ("default" | "custom").
BAILEYS_BROWSER_MODE=default
